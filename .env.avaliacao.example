# Modelo do ambiente de avaliação I9. Copiar para .env.avaliacao, que fica fora do Git.
# Não colocar segredos neste ficheiro. Não usar a base, as portas nem o volume de desenvolvimento.
# O script scripts/avaliacao.ps1 recusa portas 5432, 5435, 8000, 8010, 3000 e 3010.

POSTGRES_USER=kaivita_avaliacao
POSTGRES_PASSWORD=
POSTGRES_DB=kaivita_avaliacao
POSTGRES_PORT=5436

API_PORT=8020
WEB_PORT=3020

# Obrigatório. Gerar no anfitrião e colar só em .env.avaliacao:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRES_IN=1800
JWT_ISSUER=kaivita-avaliacao

# Palavras-passe das três contas sintéticas. Também só em .env.avaliacao.
# O script de preparação lê estes nomes e não os imprime.
AVALIACAO_PASSWORD_PRODUTOR=
AVALIACAO_PASSWORD_COMPRADOR=
AVALIACAO_PASSWORD_CONSULTA=
