# Valores só para desenvolvimento local. Não usar em produção.
# Copiar para .env se quiser substituir os valores por omissão do compose.yaml.
# A palavra-passe tem de ser segura para uma URL (sem @, :, / ou espaços).

POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB
POSTGRES_PORT=5435

API_PORT=8010
WEB_PORT=3010

# No contentor da API o anfitrião é "db". Na máquina local, fora do Docker, é "localhost".
DATABASE_URL=postgresql+psycopg://kaivita:POSTGRES_PASSWORD@localhost:5435/kaivita

# Usado no build da interface. O browser corre na máquina local e fala com a porta publicada.
# Serve só para as ligações públicas de /health e /docs. Não leva a sessão.
NEXT_PUBLIC_API_URL=http://localhost:8010

# Lida só pelo servidor Next.js, em cada pedido. Não usar o prefixo NEXT_PUBLIC.
# No Compose o contentor web recebe http://api:8000 e não usa esta linha.
API_URL=http://127.0.0.1:8010

# Obrigatório para a API arrancar. Não deixar um segredo real neste ficheiro.
# Gerar e colar o resultado no .env local, que fica fora do Git:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRES_IN=1800
JWT_ISSUER=kaivita-produtor-academico
